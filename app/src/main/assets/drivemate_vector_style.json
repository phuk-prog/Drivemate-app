      ],
      "tileSize": 256,
      "maxzoom": 19
    },
    "tomtom-high-detail": {
      "type": "raster",
      "tiles": [
        "https://api.tomtom.com/map/1/tile/basic/__TOMTOM_DETAIL_STYLE__/{z}/{x}/{y}.png?key=__TOMTOM_KEY__"
      ],
      "tileSize": 256,
      "minzoom": 16,
      "maxzoom": 20,
